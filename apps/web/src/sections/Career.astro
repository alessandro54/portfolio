---
import ExperienceRow from '@components/career/ExperienceRow.astro';
import SectionHeader from '@components/shared/SectionHeader.astro';

interface Props {
  jobs: { date: string; company: string; role: string; desc: string; techStack: string[] }[];
  ui: (key: import('@i18n/translations').TranslationKey) => string;
}
const { jobs, ui } = Astro.props;
---

<section id="experience" class="flex flex-col gap-2 px-12 pb-24 max-[900px]:px-8 max-[900px]:pb-16">
  <SectionHeader label={ui('career_label')} title={ui('career_title')} />
  <div class="flex flex-col">
    {jobs.map((job, i) => <ExperienceRow {...job} first={i === 0} />)}
  </div>
</section>
