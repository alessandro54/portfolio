---
import SectionHeader from '@components/shared/SectionHeader.astro';
import ServiceCard from '@components/what-i-do/ServiceCard.astro';

interface Props {
  services: { icon: string; title: string; text: string }[];
  ui: (key: import('@i18n/translations').TranslationKey) => string;
}
const { services, ui } = Astro.props;
---

<section id="services" class="flex flex-col gap-2 px-12 pt-24 pb-24 max-[900px]:px-8 max-[900px]:pt-16 max-[900px]:pb-16">
  <SectionHeader label={ui('what_i_do_label')} title={ui('what_i_do_title')} soft={ui('what_i_do_soft')} />
  <div class="grid grid-cols-2 gap-px border border-[var(--rule)] rounded-xl overflow-hidden max-[900px]:grid-cols-1">
    {services.map(svc => <ServiceCard {...svc} />)}
  </div>
</section>
