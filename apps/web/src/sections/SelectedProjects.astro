---
import WorkCard from '@components/selected-projects/WorkCard.astro';
import SectionHeader from '@components/shared/SectionHeader.astro';

interface Props {
  projects: {
    num: string;
    locale: string;
    kind: string;
    title: string;
    outcome: string;
    tags: string[];
    liveUrl?: string;
    repos: { label: string; url: string }[];
  }[];
  ui: (key: import('@i18n/translations').TranslationKey) => string;
}
const { projects, ui } = Astro.props;
---

<section id="work" class="flex flex-col gap-2 px-12 pb-24 max-[900px]:px-8 max-[900px]:pb-16">
  <SectionHeader label={ui('projects_label')} title={ui('projects_title')} soft={ui('projects_soft')} />
  <div class="work-grid grid grid-cols-2 gap-px bg-[var(--rule)] border border-[var(--rule)] rounded-xl overflow-hidden max-[900px]:grid-cols-1">
    {projects.map(p => <WorkCard {...p} />)}
  </div>
</section>

<style is:global>
  .work-grid > :last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }
  @media (max-width: 900px) {
    .work-grid > :last-child:nth-child(odd) {
      grid-column: auto;
    }
  }
</style>
