---
import '../styles/global.css';
import { useTranslations } from '@i18n/translations';
import { getLocalizedValue } from '@lib/localized';
import { sanityConfig } from '@lib/sanity';
import { createImageUrlBuilder } from '@sanity/image-url';

interface Props {
  locale?: string;
  seo: {
    metaTitle?: Record<string, string>;
    metaDescription?: Record<string, string>;
    siteName?: string;
    siteUrl?: string;
    ogImage?: unknown;
    twitterHandle?: string;
    twitterCardType?: string;
    themeColorDark?: string;
    themeColorLight?: string;
    appleTouchIcon?: unknown;
    appleStatusBarStyle?: string;
    appleMobileWebAppTitle?: string;
    robotsDirective?: string;
    author?: string;
    keywords?: Record<string, string>;
  } | null;
}

const { locale = 'en', seo } = Astro.props;
const ui = useTranslations(locale);
const otherLocale = locale === 'en' ? 'es' : 'en';

const builder = createImageUrlBuilder(sanityConfig);
const ogImageUrl = seo?.ogImage ? builder.image(seo.ogImage).width(1200).height(630).url() : null;
const appleTouchIconUrl = seo?.appleTouchIcon
  ? builder.image(seo.appleTouchIcon).width(180).height(180).format('png').url()
  : null;

const title = getLocalizedValue(seo?.metaTitle, locale) || ui('meta_title');
const description = getLocalizedValue(seo?.metaDescription, locale) || ui('meta_description');
const siteName = seo?.siteName || 'Alessandro Chumpitaz';
const siteUrl = seo?.siteUrl || 'https://alessandro.chumpitaz.dev';
const canonical = `${siteUrl}/${locale}/`;
const alternate = `${siteUrl}/${otherLocale}/`;
const keywords = getLocalizedValue(seo?.keywords, locale);
const author = seo?.author || '';
const robots = seo?.robotsDirective || 'index, follow';
const twitterCard = seo?.twitterCardType || 'summary_large_image';
const twitterHandle = seo?.twitterHandle || '';
const profileData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': canonical,
  url: canonical,
  inLanguage: locale,
  mainEntity: {
    '@type': 'Person',
    '@id': `${siteUrl}/#person`,
    name: 'Alessandro Chumpitaz',
    jobTitle: locale === 'es' ? 'Ingeniero Full Stack' : 'Full Stack Engineer',
    description,
    url: `${siteUrl}/en/`,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Lima',
      addressCountry: 'PE',
    },
    knowsAbout: ['Python', 'TypeScript', 'Ruby on Rails', 'Django', 'Applied AI'],
    sameAs: ['https://www.linkedin.com/in/alessandrochumpitaz/', 'https://github.com/alessandro54'],
  },
}).replace(/</g, '\\u003c');
const themeColorDark = seo?.themeColorDark || '#09080f';
const themeColorLight = seo?.themeColorLight || '#f8f7fc';
const statusBarStyle = seo?.appleStatusBarStyle || 'black-translucent';
const appTitle = seo?.appleMobileWebAppTitle || siteName;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {author && <meta name="author" content={author} />}
    {keywords && <meta name="keywords" content={keywords} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_ES'} />
    <meta property="og:site_name" content={siteName} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}

    <!-- Twitter -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
    {twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <!-- Canonical & hreflang -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={otherLocale} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/en/`} />

    <!-- Apple -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content={statusBarStyle} />
    <meta name="apple-mobile-web-app-title" content={appTitle} />
    {appleTouchIconUrl && <link rel="apple-touch-icon" href={appleTouchIconUrl} />}

    <!-- Theme -->
    <meta name="theme-color" content={themeColorDark} media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content={themeColorLight} media="(prefers-color-scheme: light)" />

    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={profileData} />

    <script is:inline>
      (function(){
        var pref = localStorage.getItem('theme') || 'system';
        var theme;
        if (pref === 'system') {
          theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        } else {
          theme = pref;
        }
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.themePref = pref;
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
