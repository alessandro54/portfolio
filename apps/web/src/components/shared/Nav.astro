---
import { useTranslations } from '@i18n/translations';
import LangDropdown from './LangDropdown.astro';
import ThemeDropdown from './ThemeDropdown.astro';

interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const ui = useTranslations(locale);
---

<nav class="site-nav fixed inset-x-0 top-0 z-100 flex items-center justify-between px-12 py-[1.3rem] bg-[var(--nav-bg)] backdrop-blur-[20px] border-b border-[var(--rule)] transition-[background,border-color] duration-400 max-[900px]:px-6 max-[900px]:py-4">
  <div class="nav-brand flex shrink-0 items-center gap-2.5 whitespace-nowrap font-bold text-[0.9rem] tracking-[-0.01em] text-[var(--fg)]">
    <svg viewBox="0 0 64 64" width="26" height="26" class="w-[1.6rem] h-[1.6rem] shrink-0" aria-hidden="true">
      <g fill="var(--logo-face)" stroke="var(--logo-edge)" stroke-width="1.5" stroke-linejoin="round">
        <path fill-opacity=".76" d="M23.97 45.92 19 54.52 45 54.52Z M45 54.52 58 32 48.07 32Z M45 9.48 48.07 32 58 32Z M23.97 45.92 45 54.52 48.07 32Z" />
        <path fill-opacity=".83" d="M23.97 45.92 6 32 19 54.52Z" />
        <path fill-opacity=".94" d="M23.97 18.08 45 9.48 19 9.48Z M23.97 18.08 19 9.48 6 32Z M23.97 45.92 23.97 18.08 6 32Z M23.97 18.08 48.07 32 45 9.48Z M23.97 45.92 48.07 32 23.97 18.08Z" />
      </g>
      <path d="M6 32 19 9.48h26L58 32 45 54.52H19Z" fill="none" stroke="var(--logo-outline)" stroke-width="2.2" stroke-linejoin="round" />
    </svg>
    Alessandro C.
  </div>
  <div class="flex gap-[2.6rem] max-[900px]:hidden">
    <a href="#services" class="text-[0.78rem] font-normal text-[var(--mid)] no-underline transition-colors duration-200 hover:text-[var(--fg)]">{ui('nav_services')}</a>
    <a href="#work" class="text-[0.78rem] font-normal text-[var(--mid)] no-underline transition-colors duration-200 hover:text-[var(--fg)]">{ui('nav_work')}</a>
    <a href="#experience" class="text-[0.78rem] font-normal text-[var(--mid)] no-underline transition-colors duration-200 hover:text-[var(--fg)]">{ui('nav_experience')}</a>
    <a href="#contact" class="text-[0.78rem] font-normal text-[var(--mid)] no-underline transition-colors duration-200 hover:text-[var(--fg)]">{ui('nav_contact')}</a>
  </div>
  <div class="nav-controls flex shrink-0 items-center gap-3">
    <ThemeDropdown locale={locale} />
    <LangDropdown locale={locale} />
    <a href="#contact" class="nav-cta inline-flex items-center gap-[0.4rem] whitespace-nowrap px-5 py-[0.52rem] rounded-[7px] bg-[var(--accent)] text-[#09080f] text-[0.76rem] font-semibold no-underline transition-[opacity,transform] duration-200 hover:opacity-88 hover:translate-y-[-1px]">{ui('nav_hire')}</a>
  </div>
</nav>
