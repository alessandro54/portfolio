---
interface Props {
  icon: string;
  title: string;
  text: string;
}

const { icon, title, text } = Astro.props;
---

<div class="flex flex-col gap-2.5 bg-[color-mix(in_srgb,var(--bg)_10%,transparent)] backdrop-blur-lg px-8 py-[2.2rem] transition-colors duration-250 hover:bg-[color-mix(in_srgb,var(--bg)_90%,transparent)]">
  <div class="w-12 h-12 rounded-xl bg-[var(--accent-lo)] border border-[var(--accent-bd)] flex items-center justify-center text-[var(--accent)]">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      {icon === 'backend' && <><rect x="4" y="4" width="16" height="7" rx="2" /><rect x="4" y="13" width="16" height="7" rx="2" /><path d="M8 7.5h.01M8 16.5h.01M12 7.5h4M12 16.5h4" /></>}
      {icon === 'performance' && <><path d="M3.5 18a8.5 8.5 0 1 1 17 0" /><path d="m12 14 4-4" /><circle cx="12" cy="14" r="1" /><path d="M6 18h12" /></>}
      {icon === 'product' && <><rect x="3.5" y="4" width="17" height="16" rx="2" /><path d="M3.5 9h17M8 9v11m4-7h5m-5 3h5" /></>}
      {icon === 'ai' && <><circle cx="12" cy="12" r="2.5" /><circle cx="5" cy="6" r="1.5" /><circle cx="19" cy="6" r="1.5" /><circle cx="5" cy="18" r="1.5" /><circle cx="19" cy="18" r="1.5" /><path d="m10 10-4-3m8 3 4-3m-8 7-4 3m8-3 4 3" /></>}
    </svg>
  </div>
  <div class="text-[0.94rem] font-semibold tracking-[-0.01em] text-[var(--fg)] mb-[0.7rem]">
    {title}
  </div>
  <p class="text-[0.79rem] font-normal leading-[1.8] text-[var(--mid)]">
    {text}
  </p>
</div>
