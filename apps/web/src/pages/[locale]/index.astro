---
import Cursor from '@components/shared/Cursor.astro';
import Footer from '@components/shared/Footer.astro';
import Nav from '@components/shared/Nav.astro';
import Layout from '@layouts/Layout.astro';
import { getPageContent } from '@lib/page-content';
import Career from '@sections/Career.astro';
import Contact from '@sections/Contact.astro';
import Hero from '@sections/Hero.astro';
import SelectedProjects from '@sections/SelectedProjects.astro';
import Ticker from '@sections/Ticker.astro';
import WhatIDo from '@sections/WhatIDo.astro';
import WhyMe from '@sections/WhyMe.astro';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'es' } }];
}

const { locale } = Astro.params;
const content = await getPageContent(locale);
---

<Layout locale={locale} seo={content.seo}>
  <canvas id="gl" aria-hidden="true"></canvas>
  <div id="vignette" aria-hidden="true"></div>

  <div class="site">
    <Nav locale={locale} />
    <main>
      <Hero data={content.hero} ui={content.ui} />
      <Ticker items={content.ticker} />
      <WhatIDo services={content.services} ui={content.ui} />
      <WhyMe data={content.why} ui={content.ui} />
      <SelectedProjects projects={content.projects} ui={content.ui} />
      <Career jobs={content.jobs} ui={content.ui} />
      <Contact data={content.contact} ui={content.ui} />
    </main>
    <Footer locale={locale} />
  </div>
  <Cursor />
</Layout>

<script>
  const loadScene = () => import('../../scripts/scene.ts');
  const loadAnims = () => import('../../scripts/animations.ts');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if ('requestIdleCallback' in window) {
    if (!reducedMotion) requestIdleCallback(loadScene, { timeout: 200 });
    requestIdleCallback(loadAnims, { timeout: 1500 });
  } else {
    if (!reducedMotion) setTimeout(loadScene, 0);
    setTimeout(loadAnims, 100);
  }
</script>
